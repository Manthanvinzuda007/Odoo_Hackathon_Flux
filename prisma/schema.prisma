generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================
// USER & AUTH
// =============================================

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  passwordHash      String    @map("password_hash")
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  role              UserRole  @default(STAFF)
  isActive          Boolean   @default(true) @map("is_active")
  failedLoginCount  Int       @default(0) @map("failed_login_count")
  lockedUntil       DateTime? @map("locked_until")
  lastLoginAt       DateTime? @map("last_login_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]         @relation("AuditActor")
  customer            Customer?

  @@map("users")
}

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  family    String   // For rotation detection
  isRevoked Boolean  @default(false) @map("is_revoked")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([family])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("password_reset_tokens")
}

// =============================================
// CUSTOMER
// =============================================

model Customer {
  id              String    @id @default(cuid())
  customerNumber  String    @unique @map("customer_number")
  userId          String?   @unique @map("user_id")
  user            User?     @relation(fields: [userId], references: [id])
  companyName     String?   @map("company_name")
  contactName     String    @map("contact_name")
  email           String
  phone           String?
  gstin           String?   // Indian GST number
  pan             String?   // PAN number
  billingAddress  Json?     @map("billing_address")
  shippingAddress Json?     @map("shipping_address")
  notes           String?
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  quotations    Quotation[]
  subscriptions Subscription[]
  invoices      Invoice[]
  payments      Payment[]

  @@index([email])
  @@index([companyName])
  @@map("customers")
}

// =============================================
// PRODUCT & VARIANTS
// =============================================

model Product {
  id          String    @id @default(cuid())
  name        String
  sku         String    @unique
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  variants ProductVariant[]
  plans    Plan[]

  @@map("products")
}

model ProductVariant {
  id              String          @id @default(cuid())
  productId       String          @map("product_id")
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String
  sku             String          @unique
  pricePaise      Int             @map("price_paise")
  currency        String          @default("INR")
  billingInterval BillingInterval @default(MONTHLY) @map("billing_interval")
  metadata        Json?
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  @@index([productId])
  @@map("product_variants")
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
}

// =============================================
// PLAN
// =============================================

model Plan {
  id              String          @id @default(cuid())
  name            String
  description     String?
  productId       String          @map("product_id")
  product         Product         @relation(fields: [productId], references: [id])
  pricePaise      Int             @map("price_paise")
  currency        String          @default("INR")
  billingInterval BillingInterval @default(MONTHLY) @map("billing_interval")
  trialDays       Int             @default(0) @map("trial_days")
  features        Json?
  isActive        Boolean         @default(true) @map("is_active")
  isPublic        Boolean         @default(true) @map("is_public")
  sortOrder       Int             @default(0) @map("sort_order")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  deletedAt       DateTime?       @map("deleted_at")

  subscriptionLines      SubscriptionLine[]
  quotationTemplateLines QuotationTemplateLine[]

  @@index([productId])
  @@map("plans")
}

// =============================================
// TAX
// =============================================

model Tax {
  id        String   @id @default(cuid())
  name      String
  rate      Int      // Rate in basis points (e.g., 1800 = 18.00%)
  type      TaxType  @default(GST)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  invoiceLines           InvoiceLine[]
  quotationLines         QuotationLine[]
  quotationTemplateLines QuotationTemplateLine[]

  @@map("taxes")
}

enum TaxType {
  GST
  CGST
  SGST
  IGST
  CESS
  CUSTOM
}

// =============================================
// DISCOUNT
// =============================================

model Discount {
  id               String       @id @default(cuid())
  name             String
  code             String       @unique
  type             DiscountType @default(PERCENTAGE)
  valuePaise       Int?         @map("value_paise")
  percentage       Int?         // In basis points (e.g., 1000 = 10.00%)
  minPurchasePaise Int?         @map("min_purchase_paise")
  maxUsage         Int?         @map("max_usage")
  maxPerCustomer   Int?         @map("max_per_customer")
  currentUsage     Int          @default(0) @map("current_usage")
  startsAt         DateTime?    @map("starts_at")
  endsAt           DateTime?    @map("ends_at")
  isActive         Boolean      @default(true) @map("is_active")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  redemptions DiscountRedemption[]

  @@map("discounts")
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model DiscountRedemption {
  id          String   @id @default(cuid())
  discountId  String   @map("discount_id")
  discount    Discount @relation(fields: [discountId], references: [id])
  customerId  String   @map("customer_id")
  invoiceId   String?  @map("invoice_id")
  amountPaise Int      @map("amount_paise")
  redeemedAt  DateTime @default(now()) @map("redeemed_at")

  @@index([discountId])
  @@index([customerId])
  @@map("discount_redemptions")
}

// =============================================
// QUOTATION TEMPLATES
// =============================================

model QuotationTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  validDays   Int      @default(30) @map("valid_days")
  notes       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  lines      QuotationTemplateLine[]
  quotations Quotation[]

  @@map("quotation_templates")
}

model QuotationTemplateLine {
  id          String            @id @default(cuid())
  templateId  String            @map("template_id")
  template    QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  planId      String            @map("plan_id")
  plan        Plan              @relation(fields: [planId], references: [id])
  taxId       String?           @map("tax_id")
  tax         Tax?              @relation(fields: [taxId], references: [id])
  quantity    Int               @default(1)
  description String?
  sortOrder   Int               @default(0) @map("sort_order")

  @@index([templateId])
  @@map("quotation_template_lines")
}

// =============================================
// QUOTATION
// =============================================

model Quotation {
  id              String             @id @default(cuid())
  quotationNumber String             @unique @map("quotation_number")
  customerId      String             @map("customer_id")
  customer        Customer           @relation(fields: [customerId], references: [id])
  templateId      String?            @map("template_id")
  template        QuotationTemplate? @relation(fields: [templateId], references: [id])
  status          QuotationStatus    @default(DRAFT)
  subtotalPaise   Int                @default(0) @map("subtotal_paise")
  taxPaise        Int                @default(0) @map("tax_paise")
  discountPaise   Int                @default(0) @map("discount_paise")
  totalPaise      Int                @default(0) @map("total_paise")
  notes           String?
  expiresAt       DateTime?          @map("expires_at")
  sentAt          DateTime?          @map("sent_at")
  acceptedAt      DateTime?          @map("accepted_at")
  rejectedAt      DateTime?          @map("rejected_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  lines        QuotationLine[]
  subscription Subscription?

  @@index([customerId])
  @@index([status])
  @@map("quotations")
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

model QuotationLine {
  id             String    @id @default(cuid())
  quotationId    String    @map("quotation_id")
  quotation      Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int       @default(1)
  unitPricePaise Int       @map("unit_price_paise")
  taxId          String?   @map("tax_id")
  tax            Tax?      @relation(fields: [taxId], references: [id])
  taxRate        Int?      @map("tax_rate")
  taxPaise       Int       @default(0) @map("tax_paise")
  subtotalPaise  Int       @default(0) @map("subtotal_paise")
  totalPaise     Int       @default(0) @map("total_paise")
  sortOrder      Int       @default(0) @map("sort_order")

  @@index([quotationId])
  @@map("quotation_lines")
}

// =============================================
// SUBSCRIPTION
// =============================================

model Subscription {
  id                 String             @id @default(cuid())
  customerId         String             @map("customer_id")
  customer           Customer           @relation(fields: [customerId], references: [id])
  quotationId        String?            @unique @map("quotation_id")
  quotation          Quotation?         @relation(fields: [quotationId], references: [id])
  status             SubscriptionStatus @default(DRAFT)
  billingInterval    BillingInterval    @default(MONTHLY) @map("billing_interval")
  startDate          DateTime?          @map("start_date")
  endDate            DateTime?          @map("end_date")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  currentPeriodStart DateTime?          @map("current_period_start")
  currentPeriodEnd   DateTime?          @map("current_period_end")
  nextBillingDate    DateTime?          @map("next_billing_date")
  pausedAt           DateTime?          @map("paused_at")
  cancelledAt        DateTime?          @map("cancelled_at")
  cancelReason       String?            @map("cancel_reason")
  renewalCount       Int                @default(0) @map("renewal_count")
  mrrPaise           Int                @default(0) @map("mrr_paise")
  notes              String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  lines    SubscriptionLine[]
  invoices Invoice[]

  @@index([customerId])
  @@index([status])
  @@index([nextBillingDate])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CANCELLED
  CLOSED
}

model SubscriptionLine {
  id             String       @id @default(cuid())
  subscriptionId String       @map("subscription_id")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  planId         String       @map("plan_id")
  plan           Plan         @relation(fields: [planId], references: [id])
  description    String
  quantity       Int          @default(1)
  unitPricePaise Int          @map("unit_price_paise")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@index([subscriptionId])
  @@map("subscription_lines")
}

// =============================================
// INVOICE
// =============================================

model Invoice {
  id              String        @id @default(cuid())
  invoiceNumber   String        @unique @map("invoice_number")
  customerId      String        @map("customer_id")
  customer        Customer      @relation(fields: [customerId], references: [id])
  subscriptionId  String?       @map("subscription_id")
  subscription    Subscription? @relation(fields: [subscriptionId], references: [id])
  billingRunId    String?       @map("billing_run_id")
  billingRun      BillingRun?   @relation(fields: [billingRunId], references: [id])
  status          InvoiceStatus @default(DRAFT)
  subtotalPaise   Int           @default(0) @map("subtotal_paise")
  taxPaise        Int           @default(0) @map("tax_paise")
  discountPaise   Int           @default(0) @map("discount_paise")
  totalPaise      Int           @default(0) @map("total_paise")
  amountPaidPaise Int           @default(0) @map("amount_paid_paise")
  amountDuePaise  Int           @default(0) @map("amount_due_paise")
  periodStart     DateTime?     @map("period_start")
  periodEnd       DateTime?     @map("period_end")
  issueDate       DateTime      @default(now()) @map("issue_date")
  dueDate         DateTime      @map("due_date")
  paidAt          DateTime?     @map("paid_at")
  voidedAt        DateTime?     @map("voided_at")
  notes           String?
  pdfUrl          String?       @map("pdf_url")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  lines    InvoiceLine[]
  payments Payment[]

  @@unique([subscriptionId, periodStart, periodEnd])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoiceId      String  @map("invoice_id")
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int     @default(1)
  unitPricePaise Int     @map("unit_price_paise")
  taxId          String? @map("tax_id")
  tax            Tax?    @relation(fields: [taxId], references: [id])
  taxRate        Int?    @map("tax_rate")
  taxPaise       Int     @default(0) @map("tax_paise")
  discountPaise  Int     @default(0) @map("discount_paise")
  subtotalPaise  Int     @default(0) @map("subtotal_paise")
  totalPaise     Int     @default(0) @map("total_paise")
  sortOrder      Int     @default(0) @map("sort_order")

  @@index([invoiceId])
  @@map("invoice_lines")
}

// =============================================
// PAYMENT
// =============================================

model Payment {
  id              String        @id @default(cuid())
  paymentNumber   String        @unique @map("payment_number")
  invoiceId       String        @map("invoice_id")
  invoice         Invoice       @relation(fields: [invoiceId], references: [id])
  customerId      String        @map("customer_id")
  customer        Customer      @relation(fields: [customerId], references: [id])
  amountPaise     Int           @map("amount_paise")
  method          PaymentMethod @default(BANK_TRANSFER)
  status          PaymentStatus @default(PENDING)
  reference       String?
  gatewayId       String?       @map("gateway_id")
  gatewayResponse Json?         @map("gateway_response")
  notes           String?
  paidAt          DateTime?     @map("paid_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([invoiceId])
  @@index([customerId])
  @@map("payments")
}

enum PaymentMethod {
  BANK_TRANSFER
  UPI
  CARD
  CASH
  CHEQUE
  GATEWAY
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// =============================================
// SEQUENCE
// =============================================

model Sequence {
  id        String   @id @default(cuid())
  prefix    String   @unique
  nextValue Int      @default(1) @map("next_value")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("sequences")
}

// =============================================
// BILLING RUN
// =============================================

model BillingRun {
  id             String           @id @default(cuid())
  status         BillingRunStatus @default(RUNNING)
  startedAt      DateTime         @default(now()) @map("started_at")
  completedAt    DateTime?        @map("completed_at")
  totalProcessed Int              @default(0) @map("total_processed")
  totalSucceeded Int              @default(0) @map("total_succeeded")
  totalFailed    Int              @default(0) @map("total_failed")
  errors         Json?
  createdAt      DateTime         @default(now()) @map("created_at")

  invoices Invoice[]

  @@map("billing_runs")
}

enum BillingRunStatus {
  RUNNING
  COMPLETED
  FAILED
  PARTIAL
}

// =============================================
// AUDIT LOG
// =============================================

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?  @map("actor_id")
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  metadata  Json?
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// =============================================
// EMAIL LOG
// =============================================

model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  type      String
  body      String?
  status    String   @default("SENT")
  error     String?
  metadata  Json?
  sentAt    DateTime @default(now()) @map("sent_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([to])
  @@index([type])
  @@map("email_logs")
}
