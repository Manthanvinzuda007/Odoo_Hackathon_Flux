# Database
DATABASE_URL=postgresql://brightloop:brightloop@localhost:5432/brightloop?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-in-production-use-openssl-rand-base64-64
JWT_REFRESH_SECRET=change-me-refresh-secret-use-openssl-rand-base64-64
